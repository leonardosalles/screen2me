PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://screen2me:screen2me@localhost:5432/screen2me
PGSSLMODE=disable

# Optional but recommended in production for Windows/corporate/mobile networks
# where direct peer-to-peer WebRTC cannot receive media reliably.
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=username
# TURN_CREDENTIAL=password
# Or provide the full browser ICE config as JSON:
# PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn-host:3478","username":"username","credential":"password"}]
